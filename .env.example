# ==========================================
# @timmbr Platform - Environment Defaults Example
# Copy this file to .env or .env.local for local development
# ==========================================

# Primary Ingress Shell Host
PORT=3000
NEXT_PUBLIC_DOMAIN=localhost:3000

# Secondary Zones
HOME_ZONE_URL=http://localhost:3001

# Secondary Zone Port Convention:
# - shell: 3000
# - Subsequent zone apps will be assigned ports 3001, 3002, 3003...
