# Primary Ingress Shell Host
PORT=3000
NEXT_PUBLIC_DOMAIN=localhost:3000

# Secondary Zones
PRODUCTS_ZONE_URL=http://localhost:3001
CHECKOUT_ZONE_URL=http://localhost:3002
ACCOUNT_ZONE_URL=http://localhost:3003

# Secondary Zone Port Convention:
# - shell: 3000 (Landing page & Ingress Proxy)
# - products: 3001
# - checkout: 3002
# - account: 3003
