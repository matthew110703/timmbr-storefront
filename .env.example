# Primary Ingress Shell Host
PORT=3000
NEXT_PUBLIC_DOMAIN=localhost:3000

# Secondary Zones
AUTH_ZONE_URL=http://localhost:3001
PRODUCTS_ZONE_URL=http://localhost:3002
CHECKOUT_ZONE_URL=http://localhost:3003

# Secondary Zone Port Convention:
# - shell: 3000 (Landing page & Ingress Proxy)
# - auth: 3001
# - products: 3002
# - checkout: 3003
