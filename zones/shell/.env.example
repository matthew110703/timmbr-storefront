# ==========================================
# @timmbr Storefront - Shell Zone (Port 3000)
# ==========================================

PORT=3000
NEXT_PUBLIC_DOMAIN=localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Downstream Zone Proxies
PRODUCTS_ZONE_URL=http://localhost:3001
CHECKOUT_ZONE_URL=http://localhost:3002
ACCOUNT_ZONE_URL=http://localhost:3003

# Server-side sessions (BFF) — never exposed to the browser
# Optional: a different timmbr-core URL for server-to-server calls (e.g. a
# private network address in production). Defaults to NEXT_PUBLIC_API_URL.
# CORE_API_URL=http://core.internal:8000
# Must equal CORE_INTERNAL_KEY in timmbr-core/.env
CORE_INTERNAL_KEY=
# Public origin of the storefront (zone proxies redirect here)
STOREFRONT_URL=http://localhost:3000
