# ==========================================
# @timmbr Storefront - Catalog Zone (Port 3001)
# ==========================================

PORT=3001
NEXT_PUBLIC_DOMAIN=localhost:3000

# timmbr-core, as reachable from this zone's server (sessions are handled by the shell)
CORE_API_URL=http://localhost:8000

# Same value as timmbr-core's CORE_INTERNAL_KEY: listing requests then skip core's per-IP rate
# limit (the zone server calls core for every shopper). Optional locally.
CORE_INTERNAL_KEY=
