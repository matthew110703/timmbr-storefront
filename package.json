{
  "name": "timmbr-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "dev:all": "node scripts/dev-runner.js --all",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "ds:link": "node scripts/ds-link.js link",
    "ds:unlink": "node scripts/ds-link.js unlink",
    "ds:status": "node scripts/ds-link.js status",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "yalc": "1.0.0-pre.53"
  },
  "dependencies": {
    "@timmbr/eslint-config": "link:../timmbr-ds/packages/config-eslint",
    "@timmbr/hooks": "1.0.0-beta",
    "@timmbr/icons": "1.2.0",
    "@timmbr/motion": "1.1.0",
    "@timmbr/theme": "1.1.0",
    "@timmbr/tsconfig": "link:../timmbr-ds/packages/config-typescript",
    "@timmbr/ui": "1.2.0",
    "@timmbr/utils": "1.1.0"
  }
}
