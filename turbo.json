{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "PORT",
        "CORE_API_URL",
        "CORE_INTERNAL_KEY",
        "STOREFRONT_URL",
        "ACCOUNT_ZONE_URL",
        "CHECKOUT_ZONE_URL",
        "CATALOG_ZONE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_DOMAIN",
        "SKIP_ENV_VALIDATION"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "**/*.test.tsx"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
